# =========================================================================
# YUVAHUB - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in the values for local development.
# NOTE: Startup environment variable validation is ENFORCED on boot.
# Missing required variables (MONGODB_URI, JWT_SECRET, GEMINI_API_KEY, REDIS_URL if enabled)
# will terminate startup with exit code 1.
# =========================================================================

# -------------------------------------------------------------------------
# MongoDB Configuration
# -------------------------------------------------------------------------
# Required for persistent data storage (opportunities, user profiles, posts).
# To run locally:
# 1. Sign up for a free MongoDB Atlas cluster at https://www.mongodb.com/cloud/atlas
# 2. Or install MongoDB Community Edition locally (e.g., mongodb://localhost:27017/yuvahub).
# If left blank or connection fails, the app runs in "Offline Mock Mode" using static curated data.
MONGODB_URI=mongodb://localhost:27017/yuvahub
MONGODB_DB_NAME=yuvahub

# -------------------------------------------------------------------------
# Google Gemini AI API Configuration
# -------------------------------------------------------------------------
# SERVER-ONLY SECRET â€” never prefix with VITE_ and never access from browser code.
# Used only by the Express API, workers, and server-side Gemini services.
# All frontend AI requests must go through /api/v1/ai/* backend routes.
# Rotate any key that may previously have appeared in a deployed client bundle.
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_SERVER_ONLY_GEMINI_API_KEY_HERE

# -------------------------------------------------------------------------
# Application URLs & CORS Configuration
# -------------------------------------------------------------------------
# APP_URL: The self-referential URL of the hosting environment.
# For local development: http://localhost:5173
APP_URL=http://localhost:5173

# FRONTEND_URL: Used to restrict CORS request access.
# MUST match your local frontend port during development to allow API requests.
# Set to 'http://localhost:5173' for local dev, or comment out to allow all origins.
FRONTEND_URL=http://localhost:5173

# CORS_ORIGINS (Optional, Issue #374): Comma-separated allowlist of origins the
# API will accept cross-origin requests from. Overrides FRONTEND_URL/APP_URL.
# In production, requests from unlisted origins are rejected; same-origin and
# non-browser requests are always allowed.
# CORS_ORIGINS=https://yuvahub.xyz,https://app.yuvahub.xyz

# TRUST_PROXY (Issue #374): Number of reverse-proxy hops to trust so rate
# limiting keys on the real client IP (not the proxy's). Set to 'false' when
# running directly exposed to the internet.
# TRUST_PROXY=1

# REQUIRE_DB (Optional, Issue #374): Set to 'true' in deployments that must fail
# fast when MongoDB is unreachable, instead of silently starting in Mock mode.
# REQUIRE_DB=false

# VITE_API_URL & VITE_WS_URL (Optional): Used by frontend client to connect to backend server / WebSocket server.
# Defaults to current origin if not provided.
# VITE_API_URL=http://localhost:3000
# VITE_WS_URL=http://localhost:3000

# -------------------------------------------------------------------------
# Mock Authentication (Optional for offline/local dev without Firebase)
# -------------------------------------------------------------------------
# Set to 'true' if you want to test without live Firebase Auth credentials.
ENABLE_MOCK_AUTH=false

# -------------------------------------------------------------------------
# Redis Configuration (Optional)
# -------------------------------------------------------------------------
# Required for distributed token-bucket rate limiting on AI routes.
# If you don't have Redis running locally, comment this out.
# Bypassing Redis runs the app in "fail-open" mode (unlimited requests).
# Get a free cloud Redis URL instantly at https://upstash.com/
# REDIS_URL=redis://127.0.0.1:6380

# -------------------------------------------------------------------------
# Meilisearch Configuration
# -------------------------------------------------------------------------
# Required for fast full-text search.
MEILI_HOST="http://127.0.0.1:7700"
MEILI_MASTER_KEY=your_secure_meili_master_key_here


# -------------------------------------------------------------------------
# Firebase Authentication Setup Note
# -------------------------------------------------------------------------
# Firebase configuration is loaded from environment variables.
# You need to provide the following variables from your Firebase console:
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID
#
# IMPORTANT FOR LOCAL SIGN-IN (authorized-domain error):
# If you get a 'Firebase: Error (auth/unauthorized-domain)' in your browser console,
# you must authorize 'localhost' in your Firebase console:
# Go to: Firebase Console -> Authentication -> Settings -> Authorized domains -> Add 'localhost'

# -------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Required for Backend JIT Auth)
# -------------------------------------------------------------------------
# Generate a Service Account JSON key from the Firebase Console 
# (Settings -> Service Accounts -> Node.js -> Generate New Private Key).
# Convert the JSON file contents to a Base64 string and paste it here:
FIREBASE_SERVICE_ACCOUNT_BASE64="YOUR_BASE64_ENCODED_SERVICE_ACCOUNT_JSON"

# -------------------------------------------------------------------------
# EmailJS Configuration (Optional)
# -------------------------------------------------------------------------
# Required for sending automated email confirmations/notifications.
# Create a free account at https://www.emailjs.com/ and obtain these credentials.
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# -------------------------------------------------------------------------
# Cloudinary Configuration
# -------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -------------------------------------------------------------------------
# Admin Authorized Emails Configuration
# -------------------------------------------------------------------------
# Comma-separated list of emails with admin access privileges
VITE_ADMIN_EMAILS=admin1@example.com,admin2@example.com

# -------------------------------------------------------------------------
# JWT Secret Configuration
# -------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# -------------------------------------------------------------------------
# Sentry APM Configuration (Optional)
# -------------------------------------------------------------------------
# Required for application performance monitoring and error tracking.
# SENTRY_DSN_NODE=your_backend_sentry_dsn
# VITE_SENTRY_DSN_REACT=your_frontend_sentry_dsn
# SENTRY_ORG=your_sentry_organization
# SENTRY_PROJECT=your_sentry_project
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# -------------------------------------------------------------------------
# SMTP Mailer Configuration (Optional Backend Worker Emails)
# -------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="YuvaHub Alerts <noreply@yuvahub.xyz>"
