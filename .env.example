# =============================================================================
# YUVAHUB ENVIRONMENT CONFIGURATION
# =============================================================================
#
# Copy this file to `.env` and fill only the integrations you need.
#
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS/Linux:        cp .env.example .env
#
# Never commit a completed `.env` file.
#
# Labels used below:
#   [REQUIRED]     Required by startup validation.
#   [CONDITIONAL]  Required only when the related feature is enabled.
#   [OPTIONAL]     Has a default or enables an optional integration.
#   [DEVELOPMENT]  Intended only for local development or tests.
#   [PUBLIC]       Included in browser assets. Never store secrets here.
#   [SECRET]       Keep server-side and use deployment secret storage.
# =============================================================================


# -----------------------------------------------------------------------------
# CORE RUNTIME
# -----------------------------------------------------------------------------

# [OPTIONAL]
# Allowed values: development | test | production
# Default behaviour is development-oriented when omitted.
NODE_ENV=development

# [OPTIONAL]
# Intended logging threshold for deployments and future structured logging.
# Allowed values: debug | info | warn | error
LOG_LEVEL=info

# [OPTIONAL]
# Express server port. Default: 5000
PORT=5000

# [OPTIONAL]
# Canonical application URL used by SEO routes.
APP_URL=http://localhost:5173

# [OPTIONAL]
# Legacy single frontend origin used by Socket.IO.
FRONTEND_URL=http://localhost:5173

# [OPTIONAL]
# Comma-separated browser origins for deployment documentation and CORS policy.
# Keep this aligned with FRONTEND_URL until the server migrates fully to a
# multi-origin CORS parser.
CORS_ORIGINS=http://localhost:5173

# [OPTIONAL]
# Start the Node scraper dispatcher with the API server.
START_NODE_SCRAPER=false


# -----------------------------------------------------------------------------
# MONGODB
# -----------------------------------------------------------------------------

# [REQUIRED] [SECRET]
# Default MongoDB connection URI.
MONGODB_URI=

# [OPTIONAL]
# Default database name. Default: yuvahub
MONGODB_DB_NAME=yuvahub

# [OPTIONAL] [SECRET]
# Separate write/command connection. Falls back to MONGODB_URI.
MONGODB_COMMAND_URI=

# [OPTIONAL] [SECRET]
# Separate read/query connection. Falls back to MONGODB_URI.
MONGODB_QUERY_URI=

# [OPTIONAL]
# Database used with MONGODB_COMMAND_URI.
MONGODB_COMMAND_DB=

# [OPTIONAL]
# Database used with MONGODB_QUERY_URI.
MONGODB_QUERY_DB=


# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------

# [REQUIRED] [SECRET]
# Generate a long random value. Never reuse the refresh secret.
JWT_SECRET=

# [OPTIONAL IN DEVELOPMENT, REQUIRED FOR REFRESH TOKENS IN PRODUCTION] [SECRET]
JWT_REFRESH_SECRET=

# [DEVELOPMENT]
# Enables local fallback authentication. Never enable in production.
ENABLE_MOCK_AUTH=false

# [DEVELOPMENT] [SECRET]
# Optional token accepted by the mock-auth middleware.
MOCK_VALID_TOKEN=

# [DEVELOPMENT]
# Skip startup validation only for controlled tests or local diagnostics.
SKIP_ENV_VALIDATION=false


# -----------------------------------------------------------------------------
# GOOGLE GEMINI / AI
# -----------------------------------------------------------------------------

# [REQUIRED] [SECRET] [SERVER ONLY]
# Used by backend AI routes and workers. Never create VITE_GEMINI_API_KEY.
GEMINI_API_KEY=

# [OPTIONAL]
# Maximum number of in-memory AI cache entries.
AI_CACHE_MAX_SIZE=100

# [OPTIONAL]
# AI cache lifetime in milliseconds.
AI_CACHE_TTL_MS=300000


# -----------------------------------------------------------------------------
# REDIS, BULLMQ, AND EVENT BUS
# -----------------------------------------------------------------------------

# [CONDITIONAL] [SECRET]
# Required when ENABLE_REDIS, REDIS_ENABLED, or REQUIRE_REDIS is true.
REDIS_URL=

# [OPTIONAL]
ENABLE_REDIS=false

# [OPTIONAL]
REDIS_ENABLED=false

# [OPTIONAL]
REQUIRE_REDIS=false

# [OPTIONAL] [SECRET]
# RabbitMQ URL used by the event bus.
RABBITMQ_URL=


# -----------------------------------------------------------------------------
# MEILISEARCH
# -----------------------------------------------------------------------------

# [OPTIONAL]
MEILI_HOST=http://127.0.0.1:7700

# [OPTIONAL] [SECRET]
MEILI_MASTER_KEY=


# -----------------------------------------------------------------------------
# FIREBASE BROWSER SDK
# -----------------------------------------------------------------------------
# [PUBLIC] These values are bundled into the frontend. Firebase security must
# be enforced through Authentication and Firestore/Storage rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# -----------------------------------------------------------------------------
# FIREBASE ADMIN AND PUSH NOTIFICATIONS
# -----------------------------------------------------------------------------

# [OPTIONAL] [SECRET] [SERVER ONLY]
# Base64-encoded service-account JSON used by backend authentication.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# [OPTIONAL] [SECRET] [SERVER ONLY]
# JSON service-account value used by the push worker.
FIREBASE_SERVICE_ACCOUNT_KEY=

# [OPTIONAL]
# Firebase Admin project ID fallback.
FIREBASE_PROJECT_ID=

# [OPTIONAL]
# Firebase Cloud Messaging project ID.
FCM_PROJECT_ID=


# -----------------------------------------------------------------------------
# FRONTEND CONNECTIONS
# -----------------------------------------------------------------------------

# [OPTIONAL] [PUBLIC]
# Browser-facing backend API URL. Leave blank to use the current origin/proxy.
VITE_API_URL=

# [OPTIONAL] [PUBLIC]
# Browser-facing Socket.IO URL. Leave blank to use the current origin.
VITE_WS_URL=


# -----------------------------------------------------------------------------
# ADMIN ALERTS
# -----------------------------------------------------------------------------

# [OPTIONAL] [SERVER CONFIGURATION]
# Single backend alert recipient.
ADMIN_EMAIL=

# [OPTIONAL] [SERVER CONFIGURATION]
# Comma-separated backend alert recipients.
ADMIN_EMAILS=

# [OPTIONAL] [PUBLIC]
# Frontend admin email allow-list. Do not use as the sole authorization layer.
VITE_ADMIN_EMAILS=


# -----------------------------------------------------------------------------
# CLOUDINARY
# -----------------------------------------------------------------------------

# [OPTIONAL]
CLOUDINARY_CLOUD_NAME=

# [OPTIONAL]
CLOUDINARY_API_KEY=

# [OPTIONAL] [SECRET] [SERVER ONLY]
CLOUDINARY_API_SECRET=


# -----------------------------------------------------------------------------
# SMTP EMAIL WORKERS
# -----------------------------------------------------------------------------

# [OPTIONAL]
SMTP_HOST=

# [OPTIONAL]
SMTP_PORT=587

# [OPTIONAL] [SECRET]
SMTP_USER=

# [OPTIONAL] [SECRET]
SMTP_PASS=

# [OPTIONAL]
SMTP_FROM=YuvaHub Alerts <noreply@yuvahub.xyz>


# -----------------------------------------------------------------------------
# EMAILJS BROWSER INTEGRATION
# -----------------------------------------------------------------------------
# [PUBLIC] Present for compatibility with the installed browser integration.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=


# -----------------------------------------------------------------------------
# SENTRY
# -----------------------------------------------------------------------------

# [OPTIONAL] [SERVER CONFIGURATION]
SENTRY_DSN=

# [OPTIONAL] [PUBLIC]
VITE_SENTRY_DSN_REACT=

# [OPTIONAL]
SENTRY_ORG=
SENTRY_PROJECT=

# [OPTIONAL] [SECRET]
# Build-time source-map upload token. Never prefix with VITE_.
SENTRY_AUTH_TOKEN=


# -----------------------------------------------------------------------------
# DNL SCRAPER SOURCES
# -----------------------------------------------------------------------------
# [OPTIONAL]
# The scheduler derives names as SCRAPER_URL_<NORMALIZED_SOURCE_NAME>.
# Add only the adapters enabled in your deployment.
#
# SCRAPER_URL_DEVPOST=
# SCRAPER_URL_INTERNSHALA=


# -----------------------------------------------------------------------------
# DEVELOPMENT, TEST, AND BUILD CONTROLS
# -----------------------------------------------------------------------------

# [DEVELOPMENT]
DISABLE_HMR=false

# [TEST]
TEST_API_URL=http://localhost:5000

# [BUILD]
# Allowed values: true | false
# Output bundle analysis stats html during build
ANALYZE=false

CI=false

# [OPTIONAL]
DB_NAME=

SITEMAP_CACHE_TTL_SECONDS=900
